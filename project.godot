; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pira2ite"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/stretch_mode=4
boot_splash/image="uid://brveli4d50xsg"
config/icon="res://icon.svg"
boot_splash/minimum_display_time=1200

[autoload]

GameManager="*res://scripts/global_logic/gameManager.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"

[dialogue_manager]

runtime/balloon_path="res://scenes/Balloon/balloon.tscn"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Pira2ite"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg")

[gui]

theme/custom_font="uid://cvxfjkwso0jma"

